# Copy to .env and fill in. .env is gitignored.

# --- LLM provider ------------------------------------------------------------
# Which provider the agents + LLM-judge evals use: "openai" or "anthropic".
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude (used when LLM_PROVIDER=anthropic)
# Get a key at https://console.anthropic.com (separate from a Claude Pro sub).
ANTHROPIC_API_KEY=sk-ant-...
# Default is claude-opus-5-5. For a much cheaper run use claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Embeddings (for RAG over uploaded PDFs) --------------------------------
# "local" = free FastEmbed/ONNX model (no API key). "openai" = OpenAI embeddings.
EMBEDDINGS_PROVIDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Optional: LangSmith tracing --------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=av-research-agent
